rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId && incoming().id == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Friend Groups
    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 120;
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (existing().creatorId == request.auth.uid || !('creatorId' in existing()));
    }

    // Events & Gatherings
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().title is string && incoming().title.size() > 0 && incoming().title.size() <= 150;
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Tasks
    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().title is string && incoming().title.size() > 0 && incoming().title.size() <= 200;
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Notifications
    match /notifications/{notifId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().title is string && incoming().title.size() <= 200;
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
  }
}
